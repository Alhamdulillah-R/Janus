+/**
+ * Write a Janus raw extension body, marking built-in types as sent so replies are accepted.
+ */
+static int janus_put_raw(SSL_CONNECTION *s, WPACKET *pkt,
+    const JANUS_RAW_EXT *raw)
+{
+    size_t i;
+
+    if (!WPACKET_put_bytes_u16(pkt, raw->type)
+        || !WPACKET_sub_memcpy_u16(pkt, raw->data, raw->len)) {
+        SSLfatal(s, SSL_AD_INTERNAL_ERROR, ERR_R_INTERNAL_ERROR);
+        return 0;
+    }
+    for (i = 0; i < OSSL_NELEM(ext_defs); i++) {
+        if (ext_defs[i].type == raw->type) {
+            s->ext.extflags[i] |= SSL_EXT_FLAG_SENT;
+            break;
+        }
+    }
+    return 1;
+}
