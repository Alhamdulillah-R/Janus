diff --git a/ssl/janus.c b/ssl/janus.c
new file mode 100644
index 0000000..1d2fc60
--- /dev/null
+++ b/ssl/janus.c
@@ -0,0 +1,901 @@
+/*
+ * Janus: client-side ClientHello shaping on top of OpenSSL.
+ *
+ * Licensed under the Apache License 2.0 (the "License").  You may not use
+ * this file except in compliance with the License.  You can obtain a copy
+ * in the file LICENSE in the source distribution or at
+ * https://www.openssl.org/source/license.html
+ */
+
+#include <string.h>
+#include <openssl/rand.h>
+#include "ssl_local.h"
+#include "internal/ssl_unwrap.h"
+
+/**
+ * Release every list and raw body held by a config.
+ */
+void ossl_janus_config_free(JANUS_CONFIG *cfg)
+{
+    size_t i;
+
+    for (i = 0; i < JANUS_LIST_COUNT; i++) {
+        OPENSSL_free(cfg->lists[i].values);
+        cfg->lists[i].values = NULL;
+        cfg->lists[i].n = 0;
+    }
+    for (i = 0; i < cfg->raw_n; i++)
+        OPENSSL_free(cfg->raw[i].data);
+    OPENSSL_free(cfg->raw);
+    cfg->raw = NULL;
+    cfg->raw_n = 0;
+    for (i = 0; i < cfg->alps_n; i++) {
+        OPENSSL_free(cfg->alps[i].proto);
+        OPENSSL_free(cfg->alps[i].settings);
+    }
+    OPENSSL_free(cfg->alps);
+    cfg->alps = NULL;
+    cfg->alps_n = 0;
+    cfg->flags = 0;
+}
+
+/**
+ * Deep-copy src into an empty dst.
+ */
+int ossl_janus_config_copy(JANUS_CONFIG *dst, const JANUS_CONFIG *src)
+{
+    size_t i;
+
+    memset(dst, 0, sizeof(*dst));
+    dst->flags = src->flags;
+
+    for (i = 0; i < JANUS_LIST_COUNT; i++) {
+        if (src->lists[i].values == NULL)
+            continue;
+        dst->lists[i].values = OPENSSL_memdup(src->lists[i].values,
+            src->lists[i].n * sizeof(uint16_t));
+        if (dst->lists[i].values == NULL)
+            goto err;
+        dst->lists[i].n = src->lists[i].n;
+    }
+
+    for (i = 0; i < src->alps_n; i++) {
+        if (!ossl_janus_config_set_alps(dst, src->alps[i].proto,
+                src->alps[i].proto_len, src->alps[i].settings,
+                src->alps[i].settings_len))
+            goto err;
+    }
+
+    if (src->raw_n == 0)
+        return 1;
+
+    dst->raw = OPENSSL_calloc(src->raw_n, sizeof(*dst->raw));
+    if (dst->raw == NULL)
+        goto err;
+    for (i = 0; i < src->raw_n; i++) {
+        dst->raw[i].type = src->raw[i].type;
+        dst->raw[i].len = src->raw[i].len;
+        if (src->raw[i].len > 0) {
+            dst->raw[i].data = OPENSSL_memdup(src->raw[i].data, src->raw[i].len);
+            if (dst->raw[i].data == NULL) {
+                dst->raw_n = i;
+                goto err;
+            }
+        }
+    }
+    dst->raw_n = src->raw_n;
+    return 1;
+
+err:
+    ossl_janus_config_free(dst);
+    return 0;
+}
+
+/**
+ * Check that an extension order has no duplicates and keeps pre_shared_key last.
+ */
+static int janus_valid_ext_order(const uint16_t *values, size_t n)
+{
+    size_t i, j;
+
+    for (i = 0; i < n; i++) {
+        if (values[i] == JANUS_GREASE)
+            continue;
+        if (values[i] == TLSEXT_TYPE_psk && i != n - 1)
+            return 0;
+        for (j = i + 1; j < n; j++) {
+            if (values[i] == values[j])
+                return 0;
+        }
+    }
+    return 1;
+}
+
+/**
+ * Replace one wire list; NULL or n == 0 clears it.
+ */
+int ossl_janus_config_set_list(JANUS_CONFIG *cfg, int which,
+    const uint16_t *values, size_t n)
+{
+    uint16_t *copy = NULL;
+
+    if (which < 0 || which >= JANUS_LIST_COUNT) {
+        ERR_raise(ERR_LIB_SSL, ERR_R_PASSED_INVALID_ARGUMENT);
+        return 0;
+    }
+    if (values != NULL && n > 0) {
+        if (n > 0x7fff) {
+            ERR_raise(ERR_LIB_SSL, ERR_R_PASSED_INVALID_ARGUMENT);
+            return 0;
+        }
+        if (which == JANUS_LIST_EXTENSIONS && !janus_valid_ext_order(values, n)) {
+            ERR_raise_data(ERR_LIB_SSL, ERR_R_PASSED_INVALID_ARGUMENT,
+                "extension order has duplicates or pre_shared_key is not last");
+            return 0;
+        }
+        copy = OPENSSL_memdup(values, n * sizeof(uint16_t));
+        if (copy == NULL)
+            return 0;
+    } else {
+        n = 0;
+    }
+
+    OPENSSL_free(cfg->lists[which].values);
+    cfg->lists[which].values = copy;
+    cfg->lists[which].n = n;
+    return 1;
+}
+
+/**
+ * Find the raw body registered for an extension type.
+ */
+const JANUS_RAW_EXT *ossl_janus_find_raw(const JANUS_CONFIG *cfg,
+    uint16_t type)
+{
+    size_t i;
+
+    for (i = 0; i < cfg->raw_n; i++) {
+        if (cfg->raw[i].type == type)
+            return &cfg->raw[i];
+    }
+    return NULL;
+}
+
+/**
+ * Register or replace the raw body for one extension type.
+ */
+int ossl_janus_config_set_raw(JANUS_CONFIG *cfg, uint16_t type,
+    const unsigned char *data, size_t len)
+{
+    JANUS_RAW_EXT *grown;
+    unsigned char *copy = NULL;
+    size_t i;
+
+    if (len > 0xffff || (len > 0 && data == NULL) || type == JANUS_GREASE) {
+        ERR_raise(ERR_LIB_SSL, ERR_R_PASSED_INVALID_ARGUMENT);
+        return 0;
+    }
+    if (len > 0) {
+        copy = OPENSSL_memdup(data, len);
+        if (copy == NULL)
+            return 0;
+    }
+
+    for (i = 0; i < cfg->raw_n; i++) {
+        if (cfg->raw[i].type == type) {
+            OPENSSL_free(cfg->raw[i].data);
+            cfg->raw[i].data = copy;
+            cfg->raw[i].len = len;
+            return 1;
+        }
+    }
+
+    grown = OPENSSL_realloc(cfg->raw, (cfg->raw_n + 1) * sizeof(*grown));
+    if (grown == NULL) {
+        OPENSSL_free(copy);
+        return 0;
+    }
+    cfg->raw = grown;
+    cfg->raw[cfg->raw_n].type = type;
+    cfg->raw[cfg->raw_n].data = copy;
+    cfg->raw[cfg->raw_n].len = len;
+    cfg->raw_n++;
+    return 1;
+}
+
+/**
+ * Drop the raw body for one extension type; missing types are not an error.
+ */
+int ossl_janus_config_remove_raw(JANUS_CONFIG *cfg, uint16_t type)
+{
+    size_t i;
+
+    for (i = 0; i < cfg->raw_n; i++) {
+        if (cfg->raw[i].type != type)
+            continue;
+        OPENSSL_free(cfg->raw[i].data);
+        memmove(&cfg->raw[i], &cfg->raw[i + 1],
+            (cfg->raw_n - i - 1) * sizeof(*cfg->raw));
+        cfg->raw_n--;
+        return 1;
+    }
+    return 1;
+}
+
+/**
+ * Release per-connection handshake state.
+ */
+void ossl_janus_state_free(JANUS_STATE *st)
+{
+    OPENSSL_free(st->ext_order);
+    OPENSSL_free(st->alps_peer);
+    memset(st, 0, sizeof(*st));
+}
+
+/**
+ * Register or replace the client ALPS settings for one protocol.
+ */
+int ossl_janus_config_set_alps(JANUS_CONFIG *cfg, const unsigned char *proto,
+    size_t proto_len, const unsigned char *settings, size_t settings_len)
+{
+    JANUS_ALPS *grown;
+    unsigned char *proto_copy, *settings_copy = NULL;
+    size_t i;
+
+    if (proto == NULL || proto_len == 0 || proto_len > 255
+        || settings_len > 0xffff || (settings_len > 0 && settings == NULL)) {
+        ERR_raise(ERR_LIB_SSL, ERR_R_PASSED_INVALID_ARGUMENT);
+        return 0;
+    }
+    if (settings_len > 0) {
+        settings_copy = OPENSSL_memdup(settings, settings_len);
+        if (settings_copy == NULL)
+            return 0;
+    }
+
+    for (i = 0; i < cfg->alps_n; i++) {
+        if (cfg->alps[i].proto_len == proto_len
+            && memcmp(cfg->alps[i].proto, proto, proto_len) == 0) {
+            OPENSSL_free(cfg->alps[i].settings);
+            cfg->alps[i].settings = settings_copy;
+            cfg->alps[i].settings_len = settings_len;
+            return 1;
+        }
+    }
+
+    proto_copy = OPENSSL_memdup(proto, proto_len);
+    if (proto_copy == NULL) {
+        OPENSSL_free(settings_copy);
+        return 0;
+    }
+    grown = OPENSSL_realloc(cfg->alps, (cfg->alps_n + 1) * sizeof(*grown));
+    if (grown == NULL) {
+        OPENSSL_free(proto_copy);
+        OPENSSL_free(settings_copy);
+        return 0;
+    }
+    cfg->alps = grown;
+    cfg->alps[cfg->alps_n].proto = proto_copy;
+    cfg->alps[cfg->alps_n].proto_len = proto_len;
+    cfg->alps[cfg->alps_n].settings = settings_copy;
+    cfg->alps[cfg->alps_n].settings_len = settings_len;
+    cfg->alps_n++;
+    return 1;
+}
+
+/**
+ * Whether the ClientHello carried extension |type| from its raw body.
+ */
+const JANUS_RAW_EXT *ossl_janus_sent_raw(const SSL_CONNECTION *s, uint16_t type)
+{
+    const JANUS_RAW_EXT *raw = ossl_janus_find_raw(&s->janus, type);
+    const uint16_t *order;
+    size_t n, i;
+
+    if (raw == NULL || s->janus.lists[JANUS_LIST_EXTENSIONS].values == NULL)
+        return raw;
+
+    ossl_janus_ext_order(s, &order, &n);
+    for (i = 0; i < n; i++) {
+        if (order[i] == type)
+            return raw;
+    }
+    return NULL;
+}
+
+/**
+ * Whether an ALPS ClientHello body lists protocol |proto|.
+ */
+static int janus_alps_offers(const JANUS_RAW_EXT *raw, const unsigned char *proto,
+    size_t proto_len)
+{
+    PACKET body, list, name;
+
+    if (!PACKET_buf_init(&body, raw->data, raw->len)
+        || !PACKET_as_length_prefixed_2(&body, &list))
+        return 0;
+
+    while (PACKET_remaining(&list) > 0) {
+        if (!PACKET_get_length_prefixed_1(&list, &name))
+            return 0;
+        if (PACKET_remaining(&name) == proto_len
+            && memcmp(PACKET_data(&name), proto, proto_len) == 0)
+            return 1;
+    }
+    return 0;
+}
+
+/**
+ * Pick up the server's ALPS extension from EncryptedExtensions (called after ALPN is parsed).
+ */
+int ossl_janus_process_server_alps(SSL_CONNECTION *s, PACKET *extensions)
+{
+    PACKET exts = *extensions, body;
+    unsigned int type;
+
+    while (PACKET_remaining(&exts) > 0) {
+        const JANUS_RAW_EXT *raw;
+
+        if (!PACKET_get_net_2(&exts, &type)
+            || !PACKET_get_length_prefixed_2(&exts, &body)) {
+            SSLfatal(s, SSL_AD_DECODE_ERROR, SSL_R_BAD_EXTENSION);
+            return 0;
+        }
+        if (type != JANUS_EXT_ALPS && type != JANUS_EXT_ALPS_OLD)
+            continue;
+
+        raw = ossl_janus_sent_raw(s, (uint16_t)type);
+        if (raw == NULL) {
+            SSLfatal(s, SSL_AD_UNSUPPORTED_EXTENSION, SSL_R_UNSOLICITED_EXTENSION);
+            return 0;
+        }
+        if (s->janus_state.alps_type != 0
+            || s->s3.alpn_selected == NULL
+            || !janus_alps_offers(raw, s->s3.alpn_selected, s->s3.alpn_selected_len)) {
+            SSLfatal(s, SSL_AD_ILLEGAL_PARAMETER, SSL_R_BAD_EXTENSION);
+            return 0;
+        }
+
+        OPENSSL_free(s->janus_state.alps_peer);
+        s->janus_state.alps_peer = NULL;
+        s->janus_state.alps_peer_len = 0;
+        if (PACKET_remaining(&body) > 0
+            && !PACKET_memdup(&body, &s->janus_state.alps_peer,
+                &s->janus_state.alps_peer_len)) {
+            SSLfatal(s, SSL_AD_INTERNAL_ERROR, ERR_R_INTERNAL_ERROR);
+            return 0;
+        }
+        s->janus_state.alps_type = (uint16_t)type;
+        s->janus_state.alps_pending = 1;
+    }
+    return 1;
+}
+
+/**
+ * Body of the client EncryptedExtensions: the ALPS extension with our settings for the negotiated protocol.
+ */
+int ossl_janus_put_client_alps(SSL_CONNECTION *s, WPACKET *pkt)
+{
+    const JANUS_ALPS *alps = NULL;
+    size_t i;
+
+    for (i = 0; i < s->janus.alps_n; i++) {
+        if (s->janus.alps[i].proto_len == s->s3.alpn_selected_len
+            && memcmp(s->janus.alps[i].proto, s->s3.alpn_selected,
+                   s->s3.alpn_selected_len) == 0) {
+            alps = &s->janus.alps[i];
+            break;
+        }
+    }
+
+    if (!WPACKET_start_sub_packet_u16(pkt)
+        || !WPACKET_put_bytes_u16(pkt, s->janus_state.alps_type)
+        || !WPACKET_start_sub_packet_u16(pkt)
+        || (alps != NULL && alps->settings_len > 0
+            && !WPACKET_memcpy(pkt, alps->settings, alps->settings_len))
+        || !WPACKET_close(pkt)
+        || !WPACKET_close(pkt)) {
+        SSLfatal(s, SSL_AD_INTERNAL_ERROR, ERR_R_INTERNAL_ERROR);
+        return 0;
+    }
+    s->janus_state.alps_pending = 0;
+    return 1;
+}
+
+/**
+ * Map a list to the row whose GREASE values it uses; key_share reuses supported_groups.
+ */
+static int janus_grease_row(int which)
+{
+    if (which == JANUS_LIST_KEY_SHARES)
+        return JANUS_LIST_GROUPS;
+    return which;
+}
+
+/**
+ * Fill every GREASE row with values that are distinct inside the row.
+ */
+static int janus_seed_grease(SSL_CONNECTION *s)
+{
+    unsigned char seed[JANUS_LIST_COUNT * JANUS_GREASE_PER_LIST];
+    size_t row, k, prev;
+
+    if (RAND_bytes_ex(SSL_CONNECTION_GET_CTX(s)->libctx, seed, sizeof(seed), 0) <= 0)
+        return 0;
+
+    for (row = 0; row < JANUS_LIST_COUNT; row++) {
+        for (k = 0; k < JANUS_GREASE_PER_LIST; k++) {
+            unsigned int nibble = seed[row * JANUS_GREASE_PER_LIST + k] & 0xf0;
+
+            for (prev = 0; prev < k; prev++) {
+                if ((s->janus_state.grease[row][prev] & 0xf0) == nibble) {
+                    nibble = (nibble + 0x10) & 0xf0;
+                    prev = (size_t)-1;
+                }
+            }
+            s->janus_state.grease[row][k] = (uint16_t)(((nibble | 0x0a) << 8) | nibble | 0x0a);
+        }
+    }
+    return 1;
+}
+
+/**
+ * Shuffle the configured extension order, leaving GREASE, padding and pre_shared_key in place.
+ */
+static int janus_permute_ext_order(SSL_CONNECTION *s)
+{
+    const JANUS_LIST *order = &s->janus.lists[JANUS_LIST_EXTENSIONS];
+    size_t *slots = NULL, nslots = 0, i;
+    uint32_t r;
+    int ok = 0;
+
+    s->janus_state.ext_order = OPENSSL_memdup(order->values,
+        order->n * sizeof(uint16_t));
+    if (s->janus_state.ext_order == NULL)
+        return 0;
+    s->janus_state.ext_order_n = order->n;
+
+    slots = OPENSSL_malloc(order->n * sizeof(*slots));
+    if (slots == NULL)
+        goto end;
+    for (i = 0; i < order->n; i++) {
+        uint16_t type = order->values[i];
+
+        if (type == JANUS_GREASE || type == TLSEXT_TYPE_padding
+            || type == TLSEXT_TYPE_psk)
+            continue;
+        slots[nslots++] = i;
+    }
+
+    for (i = nslots; i > 1; i--) {
+        size_t j;
+        uint16_t tmp;
+
+        if (RAND_bytes_ex(SSL_CONNECTION_GET_CTX(s)->libctx,
+                (unsigned char *)&r, sizeof(r), 0)
+            <= 0)
+            goto end;
+        j = r % i;
+        tmp = s->janus_state.ext_order[slots[i - 1]];
+        s->janus_state.ext_order[slots[i - 1]] = s->janus_state.ext_order[slots[j]];
+        s->janus_state.ext_order[slots[j]] = tmp;
+    }
+    ok = 1;
+
+end:
+    OPENSSL_free(slots);
+    return ok;
+}
+
+/**
+ * Prepare GREASE values and extension order for a fresh (non-HRR) ClientHello.
+ */
+int ossl_janus_new_hello(SSL_CONNECTION *s)
+{
+    ossl_janus_state_free(&s->janus_state);
+
+    if (!janus_seed_grease(s))
+        return 0;
+    if ((s->janus.flags & JANUS_FLAG_PERMUTE_EXTENSIONS) != 0
+        && s->janus.lists[JANUS_LIST_EXTENSIONS].values != NULL
+        && !janus_permute_ext_order(s))
+        return 0;
+
+    s->janus_state.seeded = 1;
+    return 1;
+}
+
+/**
+ * Return the configured list, or NULL when OpenSSL's own encoding applies.
+ */
+const JANUS_LIST *ossl_janus_list(const SSL_CONNECTION *s, int which)
+{
+    if (s->server || s->janus.lists[which].values == NULL)
+        return NULL;
+    return &s->janus.lists[which];
+}
+
+/**
+ * Return the extension order in effect for this connection.
+ */
+void ossl_janus_ext_order(const SSL_CONNECTION *s, const uint16_t **order,
+    size_t *n)
+{
+    if (s->janus_state.ext_order != NULL) {
+        *order = s->janus_state.ext_order;
+        *n = s->janus_state.ext_order_n;
+        return;
+    }
+    *order = s->janus.lists[JANUS_LIST_EXTENSIONS].values;
+    *n = s->janus.lists[JANUS_LIST_EXTENSIONS].n;
+}
+
+/**
+ * GREASE value for the n-th placeholder of a list in this handshake.
+ */
+uint16_t ossl_janus_grease(const SSL_CONNECTION *s, int which,
+    size_t occurrence)
+{
+    if (!s->janus_state.seeded || which < 0 || which >= JANUS_LIST_COUNT)
+        return 0;
+    return s->janus_state.grease[janus_grease_row(which)][occurrence % JANUS_GREASE_PER_LIST];
+}
+
+/**
+ * Write the u16 entries of a list, substituting GREASE placeholders.
+ */
+int ossl_janus_put_list(const SSL_CONNECTION *s, WPACKET *pkt, int which)
+{
+    const JANUS_LIST *list = &s->janus.lists[which];
+    size_t i, grease_n = 0;
+
+    for (i = 0; i < list->n; i++) {
+        uint16_t v = list->values[i];
+
+        if (v == JANUS_GREASE)
+            v = ossl_janus_grease(s, which, grease_n++);
+        if (!WPACKET_put_bytes_u16(pkt, v))
+            return 0;
+    }
+    return 1;
+}
+
+/**
+ * Write a GREASE extension: the first is empty, later ones carry one zero byte.
+ */
+int ossl_janus_put_grease_ext(const SSL_CONNECTION *s, WPACKET *pkt,
+    size_t occurrence)
+{
+    uint16_t type = ossl_janus_grease(s, JANUS_LIST_EXTENSIONS, occurrence);
+
+    if (!WPACKET_put_bytes_u16(pkt, type))
+        return 0;
+    if (occurrence == 0)
+        return WPACKET_put_bytes_u16(pkt, 0);
+    return WPACKET_put_bytes_u16(pkt, 1) && WPACKET_put_bytes_u8(pkt, 0);
+}
+
+/**
+ * Append "name" to a ':'-joined list buffer that has room for it.
+ */
+static void janus_join(char *buf, const char *prefix, const char *name)
+{
+    if (buf[0] != '\0')
+        strcat(buf, ":");
+    strcat(buf, prefix);
+    strcat(buf, name);
+}
+
+/**
+ * Check whether value appears in a list.
+ */
+static int janus_list_has(const JANUS_LIST *list, uint16_t value)
+{
+    size_t i;
+
+    for (i = 0; i < list->n; i++) {
+        if (list->values[i] == value)
+            return 1;
+    }
+    return 0;
+}
+
+/**
+ * Enable exactly the ciphers named by the wire cipher list; unknown IDs stay wire-only.
+ */
+static int janus_sync_ciphers(SSL_CTX *ctx, SSL *ssl, const JANUS_LIST *list)
+{
+    char *tls12 = NULL, *tls13 = NULL;
+    size_t i;
+    int ok = 0;
+
+    tls12 = OPENSSL_zalloc(list->n * 64 + 1);
+    tls13 = OPENSSL_zalloc(list->n * 64 + 1);
+    if (tls12 == NULL || tls13 == NULL)
+        goto end;
+
+    for (i = 0; i < list->n; i++) {
+        const SSL_CIPHER *c;
+
+        if (list->values[i] == JANUS_GREASE)
+            continue;
+        c = ssl3_get_cipher_by_id(SSL3_CK_CIPHERSUITE_FLAG | list->values[i]);
+        if (c == NULL || c->valid == 0 || c->name == NULL || strlen(c->name) > 62)
+            continue;
+        if (c->min_tls >= TLS1_3_VERSION)
+            janus_join(tls13, "", c->name);
+        else
+            janus_join(tls12, "", c->name);
+    }
+
+    if (ctx != NULL) {
+        if (!SSL_CTX_set_ciphersuites(ctx, tls13))
+            goto end;
+        if (tls12[0] != '\0' && !SSL_CTX_set_cipher_list(ctx, tls12))
+            goto end;
+    } else {
+        if (!SSL_set_ciphersuites(ssl, tls13))
+            goto end;
+        if (tls12[0] != '\0' && !SSL_set_cipher_list(ssl, tls12))
+            goto end;
+    }
+    ok = 1;
+
+end:
+    OPENSSL_free(tls12);
+    OPENSSL_free(tls13);
+    return ok;
+}
+
+/**
+ * Enable the wire groups in order, marking key_share layout members with '*'.
+ */
+static int janus_sync_groups(SSL_CTX *ctx, SSL *ssl, const JANUS_CONFIG *cfg)
+{
+    const JANUS_LIST *groups = &cfg->lists[JANUS_LIST_GROUPS];
+    const JANUS_LIST *shares = &cfg->lists[JANUS_LIST_KEY_SHARES];
+    SSL_CTX *lookup = ctx != NULL ? ctx : SSL_get_SSL_CTX(ssl);
+    char *buf;
+    size_t i;
+    int ok = 0;
+
+    buf = OPENSSL_zalloc(groups->n * 64 + 1);
+    if (buf == NULL)
+        return 0;
+
+    for (i = 0; i < groups->n; i++) {
+        const char *name;
+
+        if (groups->values[i] == JANUS_GREASE)
+            continue;
+        name = tls1_group_id2name(lookup, groups->values[i]);
+        if (name == NULL || strlen(name) > 61)
+            continue;
+        janus_join(buf, janus_list_has(shares, groups->values[i]) ? "*" : "", name);
+    }
+
+    if (buf[0] == '\0') {
+        ok = 1;
+    } else if (ctx != NULL) {
+        ok = SSL_CTX_set1_groups_list(ctx, buf);
+    } else {
+        ok = SSL_set1_groups_list(ssl, buf);
+    }
+    OPENSSL_free(buf);
+    return ok;
+}
+
+/**
+ * Store the wire signature algorithms (minus GREASE) as the configured list.
+ */
+static int janus_sync_sigalgs(CERT *cert, const JANUS_LIST *list)
+{
+    uint16_t *ids;
+    size_t i, n = 0;
+    int ok;
+
+    ids = OPENSSL_malloc_array(list->n, sizeof(*ids));
+    if (ids == NULL)
+        return 0;
+    for (i = 0; i < list->n; i++) {
+        if (list->values[i] != JANUS_GREASE)
+            ids[n++] = list->values[i];
+    }
+    ok = n == 0 || tls1_set_raw_sigalgs(cert, ids, n, 0);
+    OPENSSL_free(ids);
+    return ok;
+}
+
+/**
+ * Derive the protocol version range from the wire supported_versions list.
+ */
+static int janus_sync_versions(SSL_CTX *ctx, SSL *ssl, const JANUS_LIST *list)
+{
+    int min_version = 0, max_version = 0;
+    size_t i;
+
+    for (i = 0; i < list->n; i++) {
+        int v = list->values[i];
+
+        if (v < SSL3_VERSION || v > TLS1_3_VERSION)
+            continue;
+        if (min_version == 0 || v < min_version)
+            min_version = v;
+        if (v > max_version)
+            max_version = v;
+    }
+    if (max_version == 0)
+        return 1;
+
+    if (ctx != NULL)
+        return SSL_CTX_set_min_proto_version(ctx, min_version)
+            && SSL_CTX_set_max_proto_version(ctx, max_version);
+    return SSL_set_min_proto_version(ssl, min_version)
+        && SSL_set_max_proto_version(ssl, max_version);
+}
+
+/**
+ * Configure OpenSSL's own cipher, group, sigalg and version settings from the wire lists.
+ */
+static int janus_sync_internal(SSL_CTX *ctx, SSL *ssl, const JANUS_CONFIG *cfg,
+    CERT *cert)
+{
+    if (cfg->lists[JANUS_LIST_CIPHERS].values != NULL
+        && !janus_sync_ciphers(ctx, ssl, &cfg->lists[JANUS_LIST_CIPHERS]))
+        return 0;
+    if (cfg->lists[JANUS_LIST_GROUPS].values != NULL
+        && !janus_sync_groups(ctx, ssl, cfg))
+        return 0;
+    if (cfg->lists[JANUS_LIST_SIGALGS].values != NULL
+        && !janus_sync_sigalgs(cert, &cfg->lists[JANUS_LIST_SIGALGS]))
+        return 0;
+    if (cfg->lists[JANUS_LIST_VERSIONS].values != NULL
+        && !janus_sync_versions(ctx, ssl, &cfg->lists[JANUS_LIST_VERSIONS]))
+        return 0;
+    return 1;
+}
+
+int SSL_CTX_janus_sync_internal(SSL_CTX *ctx)
+{
+    return janus_sync_internal(ctx, NULL, &ctx->janus, ctx->cert);
+}
+
+int SSL_janus_sync_internal(SSL *s)
+{
+    SSL_CONNECTION *sc = SSL_CONNECTION_FROM_SSL(s);
+
+    if (sc == NULL)
+        return 0;
+    return janus_sync_internal(NULL, s, &sc->janus, sc->cert);
+}
+
+int SSL_CTX_janus_set_list(SSL_CTX *ctx, int which, const uint16_t *values,
+    size_t n)
+{
+    return ossl_janus_config_set_list(&ctx->janus, which, values, n);
+}
+
+int SSL_janus_set_list(SSL *s, int which, const uint16_t *values, size_t n)
+{
+    SSL_CONNECTION *sc = SSL_CONNECTION_FROM_SSL(s);
+
+    if (sc == NULL)
+        return 0;
+    return ossl_janus_config_set_list(&sc->janus, which, values, n);
+}
+
+size_t SSL_janus_get_list(const SSL *s, int which, uint16_t *out, size_t max)
+{
+    const SSL_CONNECTION *sc = SSL_CONNECTION_FROM_CONST_SSL(s);
+    const JANUS_LIST *list;
+
+    if (sc == NULL || which < 0 || which >= JANUS_LIST_COUNT)
+        return 0;
+    list = &sc->janus.lists[which];
+    if (out != NULL)
+        memcpy(out, list->values, (max < list->n ? max : list->n) * sizeof(uint16_t));
+    return list->n;
+}
+
+int SSL_CTX_janus_set_raw_extension(SSL_CTX *ctx, uint16_t type,
+    const unsigned char *data, size_t len)
+{
+    return ossl_janus_config_set_raw(&ctx->janus, type, data, len);
+}
+
+int SSL_janus_set_raw_extension(SSL *s, uint16_t type,
+    const unsigned char *data, size_t len)
+{
+    SSL_CONNECTION *sc = SSL_CONNECTION_FROM_SSL(s);
+
+    if (sc == NULL)
+        return 0;
+    return ossl_janus_config_set_raw(&sc->janus, type, data, len);
+}
+
+int SSL_CTX_janus_remove_raw_extension(SSL_CTX *ctx, uint16_t type)
+{
+    return ossl_janus_config_remove_raw(&ctx->janus, type);
+}
+
+int SSL_janus_remove_raw_extension(SSL *s, uint16_t type)
+{
+    SSL_CONNECTION *sc = SSL_CONNECTION_FROM_SSL(s);
+
+    if (sc == NULL)
+        return 0;
+    return ossl_janus_config_remove_raw(&sc->janus, type);
+}
+
+int SSL_CTX_janus_set_flags(SSL_CTX *ctx, uint32_t flags)
+{
+    ctx->janus.flags = flags;
+    return 1;
+}
+
+int SSL_janus_set_flags(SSL *s, uint32_t flags)
+{
+    SSL_CONNECTION *sc = SSL_CONNECTION_FROM_SSL(s);
+
+    if (sc == NULL)
+        return 0;
+    sc->janus.flags = flags;
+    return 1;
+}
+
+uint32_t SSL_janus_get_flags(const SSL *s)
+{
+    const SSL_CONNECTION *sc = SSL_CONNECTION_FROM_CONST_SSL(s);
+
+    if (sc == NULL)
+        return 0;
+    return sc->janus.flags;
+}
+
+uint16_t SSL_janus_get_grease_value(const SSL *s, int which, size_t occurrence)
+{
+    const SSL_CONNECTION *sc = SSL_CONNECTION_FROM_CONST_SSL(s);
+
+    if (sc == NULL)
+        return 0;
+    return ossl_janus_grease(sc, which, occurrence);
+}
+
+int SSL_CTX_janus_set_alps(SSL_CTX *ctx, const unsigned char *proto,
+    size_t proto_len, const unsigned char *settings, size_t settings_len)
+{
+    return ossl_janus_config_set_alps(&ctx->janus, proto, proto_len, settings,
+        settings_len);
+}
+
+int SSL_janus_set_alps(SSL *s, const unsigned char *proto, size_t proto_len,
+    const unsigned char *settings, size_t settings_len)
+{
+    SSL_CONNECTION *sc = SSL_CONNECTION_FROM_SSL(s);
+
+    if (sc == NULL)
+        return 0;
+    return ossl_janus_config_set_alps(&sc->janus, proto, proto_len, settings,
+        settings_len);
+}
+
+int SSL_janus_alps_negotiated(const SSL *s)
+{
+    const SSL_CONNECTION *sc = SSL_CONNECTION_FROM_CONST_SSL(s);
+
+    if (sc == NULL)
+        return 0;
+    return sc->janus_state.alps_type != 0;
+}
+
+size_t SSL_janus_get_peer_alps(const SSL *s, const unsigned char **data)
+{
+    const SSL_CONNECTION *sc = SSL_CONNECTION_FROM_CONST_SSL(s);
+
+    if (sc == NULL || sc->janus_state.alps_type == 0) {
+        *data = NULL;
+        return 0;
+    }
+    *data = sc->janus_state.alps_peer;
+    return sc->janus_state.alps_peer_len;
+}
