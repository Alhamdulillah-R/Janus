index 0000000..c1b2e60
--- /dev/null
+++ b/include/openssl/janus.h
@@ -0,0 +1,105 @@
+/*
+ * Janus: client-side ClientHello shaping on top of OpenSSL.
+ *
+ * Licensed under the Apache License 2.0 (the "License").  You may not use
+ * this file except in compliance with the License.  You can obtain a copy
+ * in the file LICENSE in the source distribution or at
+ * https://www.openssl.org/source/license.html
+ */
+
+#ifndef OPENSSL_JANUS_H
+#define OPENSSL_JANUS_H
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+#include <openssl/ssl.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Placeholder that is replaced by a per-connection GREASE value (RFC 8701) */
+#define JANUS_GREASE 0xFFFF
+
+/* List selectors for SSL_CTX_janus_set_list / SSL_janus_set_list */
+#define JANUS_LIST_EXTENSIONS 0
+#define JANUS_LIST_CIPHERS 1
+#define JANUS_LIST_GROUPS 2
+#define JANUS_LIST_KEY_SHARES 3
+#define JANUS_LIST_SIGALGS 4
+#define JANUS_LIST_VERSIONS 5
+#define JANUS_LIST_COUNT 6
+
+/* Shuffle unpinned entries of the extension order once per connection */
+#define JANUS_FLAG_PERMUTE_EXTENSIONS 0x1u
+
+/**
+ * Set the wire layout of one ClientHello list; NULL or n == 0 restores OpenSSL behaviour.
+ */
+int SSL_CTX_janus_set_list(SSL_CTX *ctx, int which, const uint16_t *values,
+    size_t n);
+int SSL_janus_set_list(SSL *s, int which, const uint16_t *values, size_t n);
+
+/**
+ * Copy the configured wire layout of one list; returns the entry count and fills up to max values.
+ */
+size_t SSL_janus_get_list(const SSL *s, int which, uint16_t *out, size_t max);
+
+/**
+ * Send extension |type| with this exact body instead of OpenSSL's own encoding.
+ */
+int SSL_CTX_janus_set_raw_extension(SSL_CTX *ctx, uint16_t type,
+    const unsigned char *data, size_t len);
+int SSL_janus_set_raw_extension(SSL *s, uint16_t type,
+    const unsigned char *data, size_t len);
+
+/**
+ * Drop the raw body registered for |type|.
+ */
+int SSL_CTX_janus_remove_raw_extension(SSL_CTX *ctx, uint16_t type);
+int SSL_janus_remove_raw_extension(SSL *s, uint16_t type);
+
+/**
+ * Replace the JANUS_FLAG_* set.
+ */
+int SSL_CTX_janus_set_flags(SSL_CTX *ctx, uint32_t flags);
+int SSL_janus_set_flags(SSL *s, uint32_t flags);
+uint32_t SSL_janus_get_flags(const SSL *s);
+
+/**
+ * Enable in OpenSSL itself the ciphers, groups (with key shares), sigalgs and versions named by the wire lists.
+ */
+int SSL_CTX_janus_sync_internal(SSL_CTX *ctx);
+int SSL_janus_sync_internal(SSL *s);
+
+/**
+ * Report the GREASE value chosen for the current handshake; 0 before the first ClientHello.
+ */
+uint16_t SSL_janus_get_grease_value(const SSL *s, int which, size_t occurrence);
+
+/*
+ * ALPS (application_settings, 0x44cd or the older 0x4469): the ClientHello body still comes
+ * from the raw extension; when the server answers it in EncryptedExtensions for the negotiated
+ * protocol, the client sends its own EncryptedExtensions carrying these settings
+ * (empty when none are set for that protocol).
+ */
+int SSL_CTX_janus_set_alps(SSL_CTX *ctx, const unsigned char *proto,
+    size_t proto_len, const unsigned char *settings, size_t settings_len);
+int SSL_janus_set_alps(SSL *s, const unsigned char *proto, size_t proto_len,
+    const unsigned char *settings, size_t settings_len);
+
+/*
+ * Whether ALPS was negotiated on this connection.
+ */
+int SSL_janus_alps_negotiated(const SSL *s);
+
+/*
+ * Settings the server sent in its ALPS extension; returns their length.
+ */
+size_t SSL_janus_get_peer_alps(const SSL *s, const unsigned char **data);
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* OPENSSL_JANUS_H */
